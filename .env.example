# --- This server -------------------------------------------------------------
SPOTMCP_RESOURCE_URL=https://spotmcp.example.com/mcp
# Host header(s) clients use to reach the server; leave empty to disable the check behind a trusted proxy.
SPOTMCP_ALLOWED_HOSTS=spotmcp.example.com
SPOTMCP_PORT=8080
SPOTMCP_LOG_LEVEL=INFO

# --- OAuth / IdP (incoming M2M tokens) ------------------------------------------
SPOTMCP_OAUTH_ISSUER=https://idp.example.com/oauth2/default
SPOTMCP_OAUTH_AUDIENCE=api://spotmcp
# Optional; discovered from {issuer}/.well-known/openid-configuration when unset.
# SPOTMCP_OAUTH_JWKS_URL=https://idp.example.com/oauth2/default/v1/keys
# SPOTMCP_OAUTH_REQUIRED_SCOPES=spotmcp.read
# SPOTMCP_OAUTH_CLIENT_ID_CLAIMS=client_id,azp,cid,appid
# SPOTMCP_OAUTH_ALGORITHMS=RS256,ES256,PS256

# --- Rate limiting (per OAuth client) --------------------------------------------
SPOTMCP_RATE_LIMIT_PER_MINUTE=60
SPOTMCP_RATE_LIMIT_BURST=10
# SPOTMCP_RATE_LIMIT_OVERRIDES=reporting-bot=240,batch-job=10

# --- Internal saved-query REST API -------------------------------------------------
SPOTMCP_UPSTREAM_BASE_URL=https://internal.example.com/api
SPOTMCP_UPSTREAM_LIST_PATH=/saved-queries
SPOTMCP_UPSTREAM_GET_PATH=/saved-queries/{query_id}
SPOTMCP_UPSTREAM_RUN_PATH=/saved-queries/{query_id}/execute
SPOTMCP_UPSTREAM_RUN_METHOD=POST
SPOTMCP_UPSTREAM_HEALTH_PATH=/health
# none | static_bearer | api_key | client_credentials
SPOTMCP_UPSTREAM_AUTH_MODE=client_credentials
SPOTMCP_UPSTREAM_TOKEN_URL=https://idp.example.com/oauth2/default/v1/token
SPOTMCP_UPSTREAM_CLIENT_ID=spotmcp
SPOTMCP_UPSTREAM_CLIENT_SECRET=change-me
# SPOTMCP_UPSTREAM_SCOPE=queries.read
# SPOTMCP_UPSTREAM_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem

# --- Query execution limits ----------------------------------------------------------
SPOTMCP_QUERY_DEFAULT_TIMEOUT_SECONDS=30
SPOTMCP_QUERY_MAX_TIMEOUT_SECONDS=120
SPOTMCP_MAX_ROWS=1000
# SPOTMCP_ALLOWED_QUERY_IDS=sales-by-region,inventory-summary
